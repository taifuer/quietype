{
  "name": "quietype-quality",
  "version": "0.10.21",
  "private": true,
  "description": "Automated regression checks for the Quietype WordPress theme.",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/taifuer/quietype",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taifuer/quietype.git"
  },
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "scripts": {
    "env:start": "bash tests/bin/test-env.sh start",
    "env:stop": "bash tests/bin/test-env.sh stop",
    "env:seed": "bash tests/bin/test-env.sh seed",
    "env:check": "bash tests/bin/test-env.sh check",
    "test:js": "node --check assets/js/theme.js && node --check assets/js/books.js && node --check assets/js/photos.js && node --check assets/js/admin-books.js && node --check assets/js/admin-photos.js && node --input-type=module --check < assets/js/lightbox.js",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:performance": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "html-validate": "11.9.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "lighthouse": "13.4.1",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
